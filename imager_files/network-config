network:
  version: 2
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: true
      optional: false
  wifis:
    wlan0:
      dhcp4: true
      regulatory-domain: "DE"
      access-points:
        "<WIFI_SSID>":
          password: "<WIFI_PWD>"  # create with `wpa_passphrase "<WIFI_SSID>" "<WIFI_PWD>"`
      optional: false
