#!/usr/bin/env bash
# Snapshot the live system onto the rescue partitions. Runs live, no reboot.
# This is what defines your clean slate - run it whenever the current state is
# one you would be happy to return to.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$REPO_DIR/lib/common.sh"

need_root
need_cmd rsync
detect_disk
[[ "$(current_role)" == "main" ]] || die "run this from the live system, not the rescue clone"
[[ -b "$DEV_BOOT_B" && -b "$DEV_ROOT_B" ]] || die "no rescue partitions - run install.sh first"

echo "This overwrites the rescue system with the CURRENT state of this one."
confirm "Continue?" || exit 1

# Stop the stacks so the copy is consistent, and put everything back on the way
# out however we got there - including a failed rsync or a Ctrl-C.
STOPPED=()
cleanup() {
    umount "$RESCUE_BOOT_MNT" 2>/dev/null || true
    umount "$RESCUE_ROOT_MNT" 2>/dev/null || true
    for cfg in ${STOPPED[@]+"${STOPPED[@]}"}; do
        (cd "$(dirname "$cfg")" && docker compose start) || true
    done
}
trap cleanup EXIT

if systemctl is-active --quiet docker; then
    log "stopping compose stacks for a consistent copy"
    while read -r cfg; do
        (cd "$(dirname "$cfg")" && docker compose stop) || true
        STOPPED+=("$cfg")
    done < <(find /opt -maxdepth 2 -name 'docker-compose.y*ml' 2>/dev/null)
fi

mkdir -p "$RESCUE_ROOT_MNT" "$RESCUE_BOOT_MNT"
mountpoint -q "$RESCUE_ROOT_MNT" || mount "$DEV_ROOT_B" "$RESCUE_ROOT_MNT"
mountpoint -q "$RESCUE_BOOT_MNT" || mount "$DEV_BOOT_B" "$RESCUE_BOOT_MNT"

log "syncing rootfs"
rsync -aAXH --delete --info=progress2 "${RSYNC_EXCLUDES[@]}" / "$RESCUE_ROOT_MNT/"
make_runtime_dirs "$RESCUE_ROOT_MNT"

log "syncing boot partition"
rsync -a --delete \
    --exclude=autoboot.txt --exclude="$ARM_NAME" --exclude=homelab-restore.log \
    "$BOOT_DIR/" "$RESCUE_BOOT_MNT/"
set_cmdline_root "$RESCUE_BOOT_MNT/cmdline.txt" "$PART_ROOT_B"

finalise_rescue_system
date -Is > "$RESCUE_ROOT_MNT/etc/homelab-checkpoint"

sync
ok "checkpoint written $(date -Is)"
