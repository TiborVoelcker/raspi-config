#!/usr/bin/env bash
# Arm a restore and reboot into the rescue system, which overwrites this one.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$REPO_DIR/lib/common.sh"

need_root
need_tryboot_support
detect_disk
[[ -b "$DEV_ROOT_B" ]] || die "no rescue partition"
[[ -f "$BOOT_DIR/autoboot.txt" ]] || die "autoboot.txt missing - run install.sh first"

stamp="unknown"
mkdir -p "$RESCUE_ROOT_MNT"
if mount -o ro "$DEV_ROOT_B" "$RESCUE_ROOT_MNT" 2>/dev/null; then
    stamp=$(cat "$RESCUE_ROOT_MNT/etc/homelab-checkpoint" 2>/dev/null || echo unknown)
    umount "$RESCUE_ROOT_MNT"
fi

warn "This ERASES the live system and replaces it with the checkpoint."
echo "    checkpoint taken:  $stamp"
echo "    preserved:         $DATA_DIR (separate partition)"
echo "    lost:              everything else not in the checkpoint"
echo
confirm "Type y to reset" || die "cancelled"

arm_restore

ok "armed - rebooting into rescue"
sleep 2
exec reboot "0 tryboot"
