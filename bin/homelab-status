#!/usr/bin/env bash
# Read-only snapshot of where things stand. Safe to run on a card that has not
# been provisioned yet - every section degrades to a message rather than an
# error.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$REPO_DIR/lib/common.sh"

need_root   # sfdisk --disk-id and the baseline mounts both need it
detect_disk

echo "role            $(current_role)"
echo "booted tryboot  $(booted_via_tryboot && echo yes || echo no)"
echo "sd card         $DISK"
echo
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$DISK"
echo
if mountpoint -q "$DATA_DIR"; then
    echo "data            $(findmnt -no SOURCE,SIZE,USE% "$DATA_DIR")"
    [[ -f "$DATA_MARKER" ]] || warn "data marker MISSING - wrong disk mounted?"
else
    warn "data disk NOT mounted - docker will refuse to start"
fi
echo
if [[ ! -b "$DEV_ROOT_B" ]]; then
    echo "baseline        no baseline partition - run install.sh"
else
    mkdir -p "$BASELINE_ROOT_MNT"
    if mount -o ro "$DEV_ROOT_B" "$BASELINE_ROOT_MNT" 2>/dev/null; then
        stamp=$(cat "$BASELINE_ROOT_MNT$BASELINE_STAMP" 2>/dev/null || echo "")
        umount "$BASELINE_ROOT_MNT"

        if [[ -z "$stamp" ]]; then
            echo "baseline        not captured - run install.sh"
        elif days=$(age_days "$stamp"); then
            echo "baseline        $stamp  ($(human_age "$days"))"
            (( days > BASELINE_STALE_DAYS )) \
                && warn "baseline is old - recapture it or reflash the card (see USAGE.md)"
        else
            echo "baseline        $stamp"
        fi
    else
        warn "cannot read the baseline partition (already mounted, or not formatted)"
    fi
    reset_armed && warn "RESET ARMED - next tryboot will wipe the live system"
fi
exit 0
